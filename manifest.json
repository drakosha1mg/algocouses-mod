{
  "manifest_version": 3,
  "name": "AlgoCourses Grades",
  "version": "1.0.0",
  "description": "Показывает вашу оценку за каждую тему прямо в карточках курса на algocourses.ru",
  "permissions": ["storage"],
  "action": {
    "default_title": "AlgoCourses Grades",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://algocourses.ru/courses/*/standings/*",
        "https://www.algocourses.ru/courses/*/standings/*"
      ],
      "js": ["content_standings.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://algocourses.ru/courses/*",
        "https://www.algocourses.ru/courses/*"
      ],
      "exclude_matches": [
        "https://algocourses.ru/courses/*/standings/*",
        "https://www.algocourses.ru/courses/*/standings/*"
      ],
      "js": ["content_courses.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
